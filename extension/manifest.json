{
  "manifest_version": 3,
  "name": "Producer's Reference Grabber",
  "version": "1.0.0",
  "description": "Save timestamps, titles, URLs and notes from YouTube and SoundCloud into a searchable list. Export to CSV.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://soundcloud.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.audioforges.com/youtube-to-wav*",
        "https://audioforges.com/youtube-to-wav*"
      ],
      "js": [
        "audioforges.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Reference Grabber",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "save-reference": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Save a reference at the current timestamp"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
